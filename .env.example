# GEMINI_API_KEY: Required for Gemini AI API calls and Invoice OCR Parsing.
# Configured via environment variables / secrets on the server.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public URL where this app is hosted.
APP_URL="http://localhost:3000"

# SECURE JWT SECRET KEY: Used by Express server to sign and verify HMAC JWT auth tokens.
# Do NOT prefix with VITE_. Keep strictly on the server.
JWT_SECRET="YOUR_SECURE_JWT_SECRET_KEY_HERE"

# SUPABASE / DATABASE CONFIGURATION (SERVER-SIDE):
# Server-side environment variables for secure database communication
SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"

# PUBLIC CLIENT-SIDE CONFIGURATION (OPTIONAL NON-SENSITIVE FALLBACKS):
VITE_SUPABASE_URL="https://YOUR_SUPABASE_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
